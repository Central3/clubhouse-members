<form action="/sign-up" method="POST">
  <div class="field">
    <label for="first-name">First Name: </label>
    <input
      type="text"
      name="first_name"
      id="first-name"
      maxlength="100"
      value="<%= data?.first_name || '' %>"
      required
    />
    <span><%= errors.first_name?.msg %></span>
  </div>
  <div class="field">
    <label for="last-name">Last Name: </label>
    <input
      type="text"
      name="last_name"
      id="last-name"
      maxlength="100"
      value="<%= data?.last_name || '' %>"
      required
    />
    <span><%= errors.last_name?.msg %></span>
  </div>
  <div class="field">
    <label for="username">Username: </label>
    <input
      type="text"
      name="username"
      id="username"
      minlength="3"
      maxlength="100"
      value="<%= data?.username || '' %>"
      required
    />
    <span><%= errors.username?.msg %></span>
  </div>
  <div class="field">
    <label for="password">Password: </label>
    <input
      type="password"
      name="password"
      id="password"
      minlength="6"
      required
    />
    <span><%= errors.password?.msg %></span>
  </div>
  <div class="field">
    <label for="confirm-password">Confirm Password: </label>
    <input
      type="password"
      name="confirm_password"
      id="confirm-password"
      minlength="6"
      required
    />
    <span><%= errors.confirm_password?.msg %></span>
  </div>
  <button type="submit">Sign Up</button>
</form>
