<form action="/new-message" method="POST">
  <div class="field">
    <label for="message-title">Title: </label>
    <input
      type="text"
      id="message-title"
      name="message_title"
      maxlength="255"
      required
    />
  </div>
  <div class="field">
    <label for="message-content">Content: </label>
    <textarea name="message_content" id="message-content" required></textarea>
  </div>
  <button type="submit">Add</button>
</form>
