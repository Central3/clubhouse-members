<form action="/log-in" method="POST">
  <div class="field">
    <label for="username">Username: </label>
    <input
      type="text"
      name="username"
      id="username"
      minlength="3"
      maxlength="100"
      required
    />
  </div>
  <div class="field">
    <label for="password">Password: </label>
    <input
      type="password"
      name="password"
      id="password"
      minlength="6"
      required
    />
  </div>
  <button type="submit">Log In</button>
</form>
