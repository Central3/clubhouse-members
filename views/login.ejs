<form action="/log-in" method="POST">
  <div class="field">
    <label for="username">Username: </label>
    <input
      type="text"
      name="username"
      id="username"
      minlength="3"
      maxlength="100"
      value="<%= data?.username || '' %>"
      required
    />
    <span><%= errors.username?.msg %></span>
  </div>
  <div class="field">
    <label for="password">Password: </label>
    <input
      type="password"
      name="password"
      id="password"
      minlength="6"
      required
    />
    <span><%= errors.password?.msg %></span>
  </div>
  <button type="submit">Log In</button>
</form>
